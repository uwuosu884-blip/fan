#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Launcher: makes the bundled package importable, then runs the CLI."""
import os
import sys

# realpath: installed as /usr/local/bin/omen88d2 -> /opt/omen88d2/bin/omen88d2,
# so resolve the symlink to find the real project root.
ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)

from omen88d2.cli import main

if __name__ == "__main__":
    sys.exit(main())
