"""Launcher: makes the bundled package importable, then runs the CLI."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

from omen88d2.cli import main

if __name__ == "__main__":
    sys.exit(main())
